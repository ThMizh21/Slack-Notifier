# --- Google Workspace ---
# Path to the service account JSON key (keep this file out of git)
KEY_PATH=/path/to/service_account.json
# Super admin the service account impersonates via domain-wide delegation
ADMIN_EMAIL=admin@example.com
# Accounts with no login for this many days are flagged
INACTIVE_DAYS=60

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=readonly_user
DB_PASSWORD=your_password
DB_NAME=your_database

# --- Slack ---
# Incoming webhook URL; tied to one channel chosen at creation
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

